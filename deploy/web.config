<?xml version="1.0" encoding="utf-8"?>
<!--
  云海工作台 · IIS 子应用配置（第八阶段：部署到 80 主站点下的 /workspace/）

  这个文件必须和 dist/ 一起放在子应用目录（默认 C:\inetpub\wwwroot\workspace\）。
  它写在子目录里，作用域天然只覆盖 /workspace/ —— 主站根目录的「图片添加二维码工具」
  完全不受影响（IIS 的 web.config 是分层继承的，子目录只能加规则不能改父级）。
-->
<configuration>
  <system.webServer>
    <!-- 目录浏览关掉：静态站点没有列目录的需求，开着只是多一个信息泄露面 -->
    <directoryBrowse enabled="false" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      SPA fallback：Vue Router 用的是 HTML5 History 模式（createWebHistory），
      /workspace/dashboard 这种地址在服务器上没有对应实体文件，不 rewrite 就是 404。
      规则只对「既不是文件也不是目录」的请求生效 —— assets/*.js 这类真实文件
      仍然走静态文件处理（200 + 正确的 Content-Type），不会被吞成 index.html。
      重写目标是绝对路径 /workspace/index.html，避免相对路径在子应用里解析错位。
    -->
    <rewrite>
      <rules>
        <rule name="workspace SPA fallback" stopProcessing="true">
          <match url="(.*)" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/workspace/index.html" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!--
      MIME 补登记。IIS 8.5（Windows Server 2012 R2）的默认 MIME 表比现代前端产物旧，
      .json / .webp / .woff2 / .webmanifest 这类可能缺登记 —— 缺了就 404.3，页面白屏。
      先 remove 再 add 是官方推荐写法：父级已登记就覆盖、没登记就新增，两种都不会出现
      「duplicate collection entry」的 500.19。
    -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />

      <!--
        默认一律 no-cache（每次回服务器校验）—— 这条是给「入口 HTML」用的，见文件末尾的缓存策略说明。
        带内容哈希的 assets/ 在末尾用 <location> 覆盖成一年长缓存（IIS 配置是「就近生效」）。
      -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!--
          纯 HTTP + IP 跑不了 HSTS，但「不猜类型」这条与协议无关，加上没坏处。
          先 remove 再 add：万一主站 web.config 里已经有同名头，直接 add 会因
          「duplicate collection entry」整个子应用 500.19（remove 不存在的项是空操作）。
        -->
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!--
    缓存策略（2026-09-13 补）：把「入口 HTML」与「带内容哈希的构建产物」分开对待。

    为什么必须有：IIS 默认不给静态文件发任何 Cache-Control（线上实测只有 ETag / Last-Modified），
    浏览器只能按启发式规则猜新鲜度，明文 HTTP 上运营商/公司代理还会自行缓存 ——
    症状就是「同一个链接、两台设备两个版本」：某台设备把几天前的 index.html 连同那时的
    assets 一起从缓存里端出来，界面就停在旧版；而新部署的文件名带内容哈希，
    拿着旧 HTML 的设备根本不会去请求新资源，于是永远自洽地停在老版本上。

    做法：应用根一律 no-cache（上面 staticContent 里那条，覆盖 index.html 与
    /workspace/xxx 这类 SPA 回退请求 —— 回退请求的 URL 不是 index.html，
    只在 <location path="index.html"> 里设是管不到它的），只有 assets/ 覆盖成一年长缓存
    （文件名变了缓存自然失效）。这样任何一层缓存都不会再端出旧版本。
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
